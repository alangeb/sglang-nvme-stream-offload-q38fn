+def _merge_autoround_extra_config(
+    config: Dict[str, Any], dynamic: Dict[str, Any]
+) -> Dict[str, Any]:
+    """PATCH(qwen38-int8): translate AutoRound BF16 exclusions into dynamic rules.
+
+    AutoRound keeps selected modules in BF16 and lists them under
+    ``extra_config`` using UNFUSED HF module names (e.g.
+    ``model.language_model.layers.0.linear_attn.in_proj_a``). sglang builds
+    the GatedDeltaNet gate projections fused (``in_proj_ba`` = b + a), and
+    without a matching exclusion the fused module is created as a quantized
+    Marlin layer with mismatched dims and crashes at repack time
+    ("size_n = 96 is not divisible by tile_n_size = 64").
+
+    Convert every extra_config entry with bits==16 into a negative dynamic
+    rule ("-:<escaped-name>($|\\.)"), for both the HF spelling and the
+    sglang spelling of the prefix, plus the fused in_proj_ba variant.
+    """
+    import re as _re
+
+    extra_config = config.get("extra_config") or {}
+    for name, rule in extra_config.items():
+        if not isinstance(rule, dict) or rule.get("bits") != 16:
+            continue
+        candidates = {name}
+        if ".in_proj_a" in name:
+            candidates.add(name.replace(".in_proj_a", ".in_proj_ba"))
+        elif ".in_proj_b" in name:
+            candidates.add(name.replace(".in_proj_b", ".in_proj_ba"))
+        if name.startswith("model.language_model."):
+            stripped = name.replace("model.language_model.", "model.", 1)
+            candidates.add(stripped)
+            if ".in_proj_a" in stripped:
+                candidates.add(stripped.replace(".in_proj_a", ".in_proj_ba"))
+            elif ".in_proj_b" in stripped:
+                candidates.add(stripped.replace(".in_proj_b", ".in_proj_ba"))
+        for cand in candidates:
+            dynamic.setdefault("-:" + _re.escape(cand) + r"($|\.)", {"bits": 16})
+    logger.info(
+        "PATCH3(qwen38-int8): merged extra_config -> %d dynamic rules", len(dynamic)
+    )
+    return dynamic
+
+
 class GPTQConfig(QuantizationConfig):
     """Config class for GPTQ.
 
