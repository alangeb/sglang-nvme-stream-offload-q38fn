Subject: [PATCH 03/9] patch 3/9: python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py

Extracted from sglang-flash-next:latest image (COPY'd over installed pkg).

diff --git a/python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py b/python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py
index 3490fc6..74355c9 100644
--- a/python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py
+++ b/python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py
@@ -226,9 +226,27 @@ class CompressedTensorsConfig(QuantizationConfig):
                 return weights_config.block_structure
         return None
 
+    @staticmethod
+    def _expand_hf_to_sglang_names(entries: List[str]) -> List[str]:
+        # PATCH(qwen38-fp8): Qwen3_5-style checkpoints keep HF prefixes like
+        # "model.language_model.layers.N..." in quantization_config.ignore,
+        # while sglang builds modules as "model.layers.N...". Models that set
+        # hf_to_sglang_mapper = None (e.g. qwen3_5) never remap these, so
+        # ignore entries silently stop matching and BF16 layers get quantized.
+        # Keep both spellings so the ignore list always matches.
+        expanded = list(entries)
+        for entry in entries:
+            if isinstance(entry, str) and "model.language_model." in entry:
+                alt = entry.replace("model.language_model.", "model.")
+                if alt not in expanded:
+                    expanded.append(alt)
+        return expanded
+
     @classmethod
     def from_config(cls, config: Dict[str, Any]) -> CompressedTensorsConfig:
-        ignore: List[str] = cast(List[str], config.get("ignore", []))
+        ignore: List[str] = cls._expand_hf_to_sglang_names(
+            cast(List[str], config.get("ignore", []))
+        )
         quant_format = cast(str, config.get("format"))
         target_scheme_map = cls._quantization_scheme_map_from_config(config=config)
         sparsity_scheme_map, sparsity_ignore_list = cls._parse_sparsity_config(
@@ -551,11 +569,20 @@ class CompressedTensorsConfig(QuantizationConfig):
             or weight_quant.strategy == QuantizationStrategy.GROUP.value
         )
         is_static = not weight_quant.dynamic
+        # PATCH(qwen38-fp8): restore the INT/num_bits guard dropped during the
+        # scheme refactor. Without it, weight-only FP8 checkpoints (float,
+        # channel strategy, no input_activations) wrongly enter this wNa16
+        # branch and die with the misleading "CompressedTensorsW4A16Sparse24"
+        # ImportError instead of falling through to the fp8_w8a16 path.
+        is_wna16_int = (
+            weight_quant.type == QuantizationType.INT
+            and weight_quant.num_bits in WNA16_SUPPORTED_BITS
+        )
 
         # Both symmetric and asymmetric weight quant are handled by
         # CompressedTensorsWNA16 via the Marlin kernel path; asymmetric
         # checkpoints carry a weight zero-point.
-        return is_channel_group and input_quant_none and is_static
+        return is_channel_group and is_wna16_int and input_quant_none and is_static
 
     def _is_mxint4a16(self, weight_quant: BaseModel, input_quant: BaseModel) -> bool:
         input_quant_none = input_quant is None
