+    def _mamba_host_pool(self):
+        cc = getattr(self.cache, "cache_controller", None)
+        if cc is None:
+            return None
+        entry = getattr(cc, "mem_pool_host", None)
+        entry_map = getattr(entry, "entry_map", None)
