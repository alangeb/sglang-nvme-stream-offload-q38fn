+    def _pick_spill_victim(self):
+        """Oldest device-resident mamba checkpoint that is safe to demote.
+
+        Walks the mamba device LRU from the TAIL manually (the same lru_prev
+        chain get_prev_no_lock uses) instead of the leaf cursor: the just-inserted
+        node is insert_mru and most survivors are internal nodes absent from
+        evictable_device_leaves, so a leaf-only cursor finds nothing. Internal
+        nodes are legitimately spillable -- that is what a tombstone is.
+        Safety: never a node whose per-component lock_ref != 0 (a RUNNING
+        request holds it via acquire_component_lock), never host-locked, never
+        the root, never one with no device value or an existing host copy.
+        """
+        ct = self.component_type
+        lru = self.tree_core.lru_lists[ct]
+        pt = getattr(lru, "_pt", 0)
+        head = getattr(lru, "head", None)
+        skipped: list[str] = []
+        x = lru.tail.lru_prev[pt]
+        steps = 0
+        per_slot = os.environ.get("SGLANG_MAMBA_PER_SLOT", "0") == "1"
+        while x is not None and x is not head and steps < 64:
+            steps += 1
+            cd = x.component_data[ct]
+            if x is self.tree_core.root_node:
+                reason = "root"
+            elif cd.lock_ref != 0:
+                reason = "dev-locked"
+            elif cd.host_lock_ref != 0:
+                reason = "host-locked"
+            elif cd.value is None:
+                reason = "no-dev-value"
