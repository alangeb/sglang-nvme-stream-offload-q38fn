+    def _host_pool_usage(self) -> tuple[int, int]:
+        """HOST mamba pool (used, total). The [MAMBA-HOST] line historically only
+        printed the *device* allocator's available (a red herring for host-full
+        bails); this exposes the host pool's own occupancy so production can see
+        the real 'host-alloc-full' pressure. Returns (-1, -1) when absent."""
+        hp = self._mamba_host_pool()
+        if hp is None:
+            return -1, -1
+        total = int(getattr(hp, "size", -1))
+        try:
+            avail = int(hp.available_size())
+        except Exception:
+            avail = -1
+        return (total - avail if total >= 0 and avail >= 0 else -1), total
+
+    def _reclaim_host_anchor_slots(self, host_pool) -> int:
+        """PHASE-1 RETENTION FIX (per-slot only, called only when host alloc just
+        returned None). Free host mamba slots that can no longer be restored so
+        host_pool.alloc() stops returning None.
+
+        We reuse the sanctioned host-eviction path (cache.evict_host -> the tree
+        core's drive_host_eviction walk over the mamba HOST LRU) rather than
+        free()ing raw slots, so LRU membership / host-leaf sets / tombstone
+        cascade stay consistent (no double-membership, no leak). That walk frees
+        BOTH required cases in LRU order:
+          * the least-recently-used host anchor (internal node -> mamba host
+            tombstone frees its host slot; H-leaf -> atomic host eviction); and
+          * an anchor whose FULL parent has been device-evicted -- such an anchor
+            is not load-backable (load-back needs the FULL path resident) and is
+            exactly the H-leaf / internal-tombstone victim the walk selects.
+        Bounded loop: stop as soon as a slot is reclaimed or the walk stops
+        making progress. Returns host slots reclaimed.
+        """
+        before = host_pool.available_size()
+        for _ in range(8):
+            freed = self.cache.evict_host(1, self.component_type)
+            if host_pool.available_size() > before:
+                break
+            if freed <= 0:
+                break  # walk found no eligible victim -> stop, do not spin
+        return host_pool.available_size() - before
