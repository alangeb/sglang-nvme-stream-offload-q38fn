+            # this is the ideal node to demote (device copy still exists).
+            elif per_slot and cd.host_value is not None:
+                reason = "per-slot-host-already"
+            elif per_slot and x.component_data[ComponentType.FULL].value is None:
+                reason = "per-slot-full-not-device"
+            elif per_slot and (
+                x.write_through_pending_id is not None
+                or x.load_back_pending_id is not None
+            ):
+                reason = "per-slot-dma-inflight"
+            elif not per_slot and not x.backuped:
+                reason = "not-backuped"
+            elif not per_slot and x not in self.tree_core.evictable_device_leaves:
+                reason = "not-d-leaf"
+            else:
+                if skipped and mamba_host_debug_enabled():
+                    self._dump_lru_diag(lru, pt, skipped, x.id)
+                return x
+            skipped.append(f"{x.id}:{reason}")
+            x = x.lru_prev[pt]
+        if mamba_host_debug_enabled():
+            self._dump_lru_diag(lru, pt, skipped, None)
+        return None
